# Copy to .env (never commit .env). Everything is optional.

# Your TryHackMe session: the value of the connect.sid cookie on tryhackme.com
# (DevTools > Application > Cookies). Unlocks thm_my_* tools and premium rooms.
THM_SESSION=your_connect_sid_here

# Alternative to THM_SESSION: the whole Cookie header, if connect.sid alone stops working.
# THM_COOKIE=

# Set to 1 to enable tools that change your account (start/extend/terminate machines,
# vote, join/leave rooms). Off by default.
THM_ALLOW_WRITES=0
